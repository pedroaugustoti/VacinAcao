NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON_OU_PUBLISHABLE
# Fluxos clínicos usam a chave pública. Gestão Auth opcional requer credencial privada apenas no servidor.
# Somente servidor. Deixar vazio até aprovação da gestão/Auth; NUNCA usar NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Após aprovação/aplicação 028 e autorização institucional para usar as operações:
VACINACAO_GESTAO_ESCRITA=nao
# Revisão de triggers auth.users, Auth Hooks e notificações antes de criar contas:
VACINACAO_PROVISIONAMENTO_REVISADO=nao
# Envio requer SMTP/template/URL conferidos e autorização por operação. Padrão: sem envio.
VACINACAO_EMAIL_AUTORIZADO=nao
VACINACAO_EMAIL_TEMPLATE_CONFIRMADO=nao
VACINACAO_ORIGIN=
