{
  "name": "vacinacao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:sql": "node tests/sql-review.mjs",
    "test:estoque:sql": "node tests/estoque-sql.mjs",
    "test:paciente:sql": "node tests/paciente-vinculo-sql.mjs",
    "test:final:sql": "node tests/fluxo-final-sql.mjs",
    "test:gestao:sql": "node tests/management-sql.mjs",
    "homolog:read:paciente": "node --env-file-if-exists=.env.homolog.local tests/paciente-read.mjs",
    "test:busca-ativa:sql": "node tests/busca-ativa-sql.mjs",
    "test:backup": "node tests/backup-remoto.mjs",
    "test:browser:publico": "node tests/browser-publico.mjs",
    "test:e2e": "node --env-file-if-exists=.env.homolog.local tests/browser-e2e.mjs",
    "homolog:check": "node --env-file-if-exists=.env.homolog.local --experimental-strip-types tests/homologacao.mjs --check",
    "homolog:read": "node --env-file-if-exists=.env.homolog.local --experimental-strip-types tests/homologacao.mjs --read",
    "homolog:read:admin": "node --env-file-if-exists=.env.homolog.local --experimental-strip-types tests/homologacao.mjs --read-admin",
    "homolog:write": "node --env-file-if-exists=.env.homolog.local --experimental-strip-types tests/homologacao.mjs --write"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
